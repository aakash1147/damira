// Prisma Schema for DAMIRA by Gupta - Business Management System
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. ORGANIZATIONAL & EMPLOYEE MANAGEMENT
// -------------------------------------------------------------

model Department {
  id          String     @id @default(uuid()) @db.VarChar(36)
  name        String     @unique @db.VarChar(100)
  code        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  employees   Employee[]

  @@map("departments")
}

model Designation {
  id          String     @id @default(uuid()) @db.VarChar(36)
  title       String     @unique @db.VarChar(100)
  code        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  employees   Employee[]

  @@map("designations")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  NOTICE_PERIOD
  RESIGNED
  TERMINATED
  SUSPENDED
}

model Employee {
  id                 String         @id @default(uuid()) @db.VarChar(36)
  employeeCode       String         @unique @map("employee_code") @db.VarChar(50)
  firstName          String         @map("first_name") @db.VarChar(100)
  lastName           String         @map("last_name") @db.VarChar(100)
  email              String         @unique @db.VarChar(150)
  mobile             String         @unique @db.VarChar(20)
  altMobile          String?        @map("alt_mobile") @db.VarChar(20)
  gender             Gender
  dob                DateTime?      @db.Date
  dateOfJoining      DateTime       @map("date_of_joining") @db.Date
  departmentId       String?        @map("department_id") @db.VarChar(36)
  designationId      String?        @map("designation_id") @db.VarChar(36)
  reportingManagerId String?        @map("reporting_manager_id") @db.VarChar(36)
  status             EmployeeStatus @default(ACTIVE)
  profileImageUrl    String?        @map("profile_image_url") @db.VarChar(500)
  notes              String?        @db.Text
  isDeleted          Boolean        @default(false) @map("is_deleted")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  department         Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation        Designation?   @relation(fields: [designationId], references: [id], onDelete: SetNull)
  reportingManager   Employee?      @relation("ManagementHierarchy", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates       Employee[]     @relation("ManagementHierarchy")
  userAccount        User?

  @@index([departmentId])
  @@index([designationId])
  @@index([status])
  @@index([isDeleted])
  @@map("employees")
}

// -------------------------------------------------------------
// 2. AUTHENTICATION & ACCESS CONTROL (RBAC)
// -------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING_ACTIVATION
}

model User {
  id                   String        @id @default(uuid()) @db.VarChar(36)
  employeeId           String        @unique @map("employee_id") @db.VarChar(36)
  username             String        @unique @db.VarChar(100)
  email                String        @unique @db.VarChar(150)
  passwordHash         String        @map("password_hash") @db.VarChar(255)
  status               UserStatus    @default(ACTIVE)
  lastLoginAt          DateTime?     @map("last_login_at")
  lastLoginIp          String?       @map("last_login_ip") @db.VarChar(45)
  failedLoginAttempts  Int           @default(0) @map("failed_login_attempts")
  lockoutUntil         DateTime?     @map("lockout_until")
  mustChangePassword   Boolean       @default(false) @map("must_change_password")
  passwordChangedAt    DateTime?     @map("password_changed_at")
  passwordResetToken   String?       @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires DateTime?     @map("password_reset_expires")
  isDeleted            Boolean       @default(false) @map("is_deleted")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  employee             Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userRoles            UserRole[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  customerImports      CustomerImport[]
  createdCustomers     Customer[]    @relation("CustomerCreatedBy")
  updatedCustomers     Customer[]    @relation("CustomerUpdatedBy")

  @@index([status])
  @@index([isDeleted])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.VarChar(36)
  name            String           @unique @db.VarChar(100)
  slug            String           @unique @db.VarChar(100)
  description     String?          @db.VarChar(255)
  isSystemRole    Boolean          @default(false) @map("is_system_role")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.VarChar(36)
  module          String           @db.VarChar(100) // e.g. CUSTOMERS, EMPLOYEES, MASTER_DATA
  action          String           @db.VarChar(100) // e.g. VIEW, CREATE, EDIT, DELETE, IMPORT, EXPORT
  slug            String           @unique @db.VarChar(150) // e.g. CUSTOMERS:CREATE
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId      String    @map("user_id") @db.VarChar(36)
  roleId      String    @map("role_id") @db.VarChar(36)
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  assignedBy  String?   @map("assigned_by") @db.VarChar(36)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.VarChar(36)
  permissionId String     @map("permission_id") @db.VarChar(36)
  grantedAt    DateTime   @default(now()) @map("granted_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  deviceInfo  String?   @map("device_info") @db.VarChar(255)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  isRevoked   Boolean   @default(false) @map("is_revoked")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRevoked])
  @@map("refresh_tokens")
}

// -------------------------------------------------------------
// 3. MASTER DATA (GEOGRAPHIC & BUSINESS CLASSIFIERS)
// -------------------------------------------------------------

model Country {
  id          String            @id @default(uuid()) @db.VarChar(36)
  name        String            @unique @db.VarChar(100)
  iso2        String            @unique @db.VarChar(2)
  iso3        String            @unique @db.VarChar(3)
  phoneCode   String            @map("phone_code") @db.VarChar(10)
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  states      State[]
  addresses   CustomerAddress[]

  @@map("countries")
}

model State {
  id          String            @id @default(uuid()) @db.VarChar(36)
  countryId   String            @map("country_id") @db.VarChar(36)
  name        String            @db.VarChar(100)
  code        String            @db.VarChar(10) // e.g. MH, DL, KA (also GST State Code)
  gstCode     String?           @map("gst_code") @db.VarChar(5) // e.g. 27, 07
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  country     Country           @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities      City[]
  addresses   CustomerAddress[]

  @@unique([countryId, name])
  @@unique([countryId, code])
  @@index([countryId])
  @@map("states")
}

model City {
  id          String            @id @default(uuid()) @db.VarChar(36)
  stateId     String            @map("state_id") @db.VarChar(36)
  name        String            @db.VarChar(100)
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  state       State             @relation(fields: [stateId], references: [id], onDelete: Restrict)
  addresses   CustomerAddress[]

  @@unique([stateId, name])
  @@index([stateId])
  @@map("cities")
}

model CustomerType {
  id          String     @id @default(uuid()) @db.VarChar(36)
  name        String     @unique @db.VarChar(100) // Individual, Retailer, Distributor, Wholesaler, Corporate, Bulk Buyer
  code        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  customers   Customer[]

  @@map("customer_types")
}

model AddressType {
  id          String            @id @default(uuid()) @db.VarChar(36)
  name        String            @unique @db.VarChar(100) // Home, Office, Delivery, Billing, Warehouse
  code        String            @unique @db.VarChar(50)
  description String?           @db.VarChar(255)
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  addresses   CustomerAddress[]

  @@map("address_types")
}

// -------------------------------------------------------------
// 4. CUSTOMER MANAGEMENT (CRM) & ADDRESSES
// -------------------------------------------------------------

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  ARCHIVED
}

model Customer {
  id                 String            @id @default(uuid()) @db.VarChar(36)
  customerCode       String            @unique @map("customer_code") @db.VarChar(50)
  customerTypeId     String            @map("customer_type_id") @db.VarChar(36)
  firstName          String            @map("first_name") @db.VarChar(100)
  lastName           String            @map("last_name") @db.VarChar(100)
  companyName        String?           @map("company_name") @db.VarChar(200)
  email              String?           @db.VarChar(150)
  mobile             String            @db.VarChar(20)
  altMobile          String?           @map("alt_mobile") @db.VarChar(20)
  gstin              String?           @db.VarChar(20)
  pan                String?           @db.VarChar(20)
  dob                DateTime?         @db.Date
  gender             Gender?
  source             String?           @db.VarChar(100) // Direct, Referral, Website, Campaign
  status             CustomerStatus    @default(ACTIVE)
  notes              String?           @db.Text
  createdById        String?           @map("created_by_id") @db.VarChar(36)
  updatedById        String?           @map("updated_by_id") @db.VarChar(36)
  isDeleted          Boolean           @default(false) @map("is_deleted")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  customerType       CustomerType      @relation(fields: [customerTypeId], references: [id], onDelete: Restrict)
  createdBy          User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?             @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  addresses          CustomerAddress[]

  @@index([customerTypeId])
  @@index([mobile])
  @@index([email])
  @@index([status])
  @@index([isDeleted])
  @@index([createdAt])
  @@map("customers")
}

model CustomerAddress {
  id                  String       @id @default(uuid()) @db.VarChar(36)
  customerId          String       @map("customer_id") @db.VarChar(36)
  addressTypeId       String       @map("address_type_id") @db.VarChar(36)
  addressLabel        String       @map("address_label") @db.VarChar(100) // e.g. "Head Office", "Home Gurgaon"
  contactPersonName   String?      @map("contact_person_name") @db.VarChar(100)
  contactMobile       String?      @map("contact_mobile") @db.VarChar(20)
  addressLine1        String       @map("address_line_1") @db.VarChar(255)
  addressLine2        String?      @map("address_line_2") @db.VarChar(255)
  landmark            String?      @db.VarChar(150)
  countryId           String       @map("country_id") @db.VarChar(36)
  stateId             String       @map("state_id") @db.VarChar(36)
  cityId              String       @map("city_id") @db.VarChar(36)
  district            String?      @db.VarChar(100)
  postalCode          String       @map("postal_code") @db.VarChar(20)
  isDefaultBilling    Boolean      @default(false) @map("is_default_billing")
  isDefaultShipping   Boolean      @default(false) @map("is_default_shipping")
  isActive            Boolean      @default(true) @map("is_active")
  isDeleted           Boolean      @default(false) @map("is_deleted")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  customer            Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addressType         AddressType  @relation(fields: [addressTypeId], references: [id], onDelete: Restrict)
  country             Country      @relation(fields: [countryId], references: [id], onDelete: Restrict)
  state               State        @relation(fields: [stateId], references: [id], onDelete: Restrict)
  city                City         @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([addressTypeId])
  @@index([postalCode])
  @@index([isDeleted])
  @@map("customer_addresses")
}

// -------------------------------------------------------------
// 5. BULK CUSTOMER IMPORT & ERROR LOGGING
// -------------------------------------------------------------

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
}

enum DuplicateStrategy {
  SKIP
  UPDATE
  IMPORT_NEW
}

model CustomerImport {
  id                String                 @id @default(uuid()) @db.VarChar(36)
  fileName          String                 @map("file_name") @db.VarChar(255)
  fileSize          Int                    @map("file_size") // bytes
  fileFormat        String                 @map("file_format") @db.VarChar(10) // xlsx, csv
  duplicateStrategy DuplicateStrategy      @default(SKIP) @map("duplicate_strategy")
  uploadedById      String                 @map("uploaded_by_id") @db.VarChar(36)
  status            ImportStatus           @default(PENDING)
  totalRecords      Int                    @default(0) @map("total_records")
  successRecords    Int                    @default(0) @map("success_records")
  failedRecords     Int                    @default(0) @map("failed_records")
  errorReportUrl    String?                @map("error_report_url") @db.VarChar(500)
  createdAt         DateTime               @default(now()) @map("created_at")
  completedAt       DateTime?              @map("completed_at")

  uploadedBy        User                   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  errors            CustomerImportError[]

  @@index([uploadedById])
  @@index([status])
  @@map("customer_imports")
}

model CustomerImportError {
  id          String         @id @default(uuid()) @db.VarChar(36)
  importId    String         @map("import_id") @db.VarChar(36)
  rowNumber   Int            @map("row_number")
  rawRowData  Json           @map("raw_row_data")
  errorCode   String         @map("error_code") @db.VarChar(50)
  errorReason String         @map("error_reason") @db.VarChar(500)
  createdAt   DateTime       @default(now()) @map("created_at")

  import      CustomerImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@map("customer_import_errors")
}

// -------------------------------------------------------------
// 6. SYSTEM AUDIT LOGGING
// -------------------------------------------------------------

model AuditLog {
  id         String    @id @default(uuid()) @db.VarChar(36)
  userId     String?   @map("user_id") @db.VarChar(36)
  action     String    @db.VarChar(50) // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, IMPORT, EXPORT
  module     String    @db.VarChar(50) // EMPLOYEES, USERS, ROLES, CUSTOMERS, ADDRESSES, MASTER_DATA
  recordId   String?   @map("record_id") @db.VarChar(50)
  oldValues  Json?     @map("old_values")
  newValues  Json?     @map("new_values")
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
