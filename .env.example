# DAMIRA by Gupta - Environment Configuration

# Application
APP_NAME="DAMIRA by Gupta"
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=damira_user
DB_PASSWORD=DamiraUserSecure2026!
DB_NAME=damira_db
DB_ROOT_PASSWORD=DamiraRootSecure2026!

# Prisma Database Connection URL
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# Security & JWT Tokens
JWT_ACCESS_SECRET="DamiraAccessSecretKey2026!RoyalPurple"
JWT_ACCESS_EXPIRATION="900s" # 15 minutes
JWT_REFRESH_SECRET="DamiraRefreshSecretKey2026!RoyalPurple"
JWT_REFRESH_EXPIRATION="7d"  # 7 days

# CORS
CORS_ORIGIN="http://localhost:4200"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
